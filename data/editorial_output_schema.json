{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corentinlrnt/veille-redaction-belge/data/editorial_output_schema.json",
  "title": "Briefing éditorial matinal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "briefing_date",
    "headline",
    "must_know",
    "original_pitches",
    "source_leads",
    "long_term_projects",
    "watchlist",
    "editorial_note"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "briefing_date": {"type": "string"},
    "headline": {"type": "string", "minLength": 1},
    "must_know": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/mustKnow"}
    },
    "original_pitches": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/originalPitch"}
    },
    "source_leads": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/sourceLead"}
    },
    "long_term_projects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/longTermProject"}
    },
    "watchlist": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "#/$defs/watchItem"}
    },
    "editorial_note": {"type": "string"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "source_class", "url", "certainty"],
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "source_class": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "certainty": {
          "enum": ["etabli", "rapporte", "declaration", "hypothese"]
        }
      }
    },
    "mustKnow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "title",
        "new_fact",
        "why_it_matters",
        "watch_today",
        "certainty",
        "sources"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 5},
        "title": {"type": "string"},
        "new_fact": {"type": "string"},
        "why_it_matters": {"type": "string"},
        "watch_today": {"type": "string"},
        "certainty": {
          "enum": ["etabli", "rapporte", "declaration", "hypothese"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "availability"],
      "properties": {
        "name": {"type": "string"},
        "role": {"type": "string"},
        "public_contact": {"type": ["string", "null"]},
        "contact_source": {"type": ["string", "null"], "format": "uri"},
        "availability": {
          "enum": ["confirmee", "probable", "a_verifier", "non_recherchee"]
        }
      }
    },
    "originalPitch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pitch",
        "central_question",
        "angle_engine",
        "fresh_signal",
        "dominant_coverage",
        "original_move",
        "factual_basis",
        "checks_needed",
        "field_or_incarnation",
        "tv_hook",
        "radio_hook",
        "people_to_explore",
        "verdict",
        "risk_flags",
        "sources"
      ],
      "properties": {
        "title": {"type": "string"},
        "pitch": {"type": "string", "pattern": "^On pourrait raconter"},
        "central_question": {"type": "string"},
        "angle_engine": {
          "enum": [
            "concrete_impact",
            "embodied_number",
            "promise_test",
            "system_backstage",
            "how_to",
            "external_mirror",
            "power_shift",
            "revealing_breather"
          ]
        },
        "fresh_signal": {"type": "string"},
        "dominant_coverage": {"type": "string"},
        "original_move": {"type": "string"},
        "factual_basis": {"type": "array", "items": {"type": "string"}},
        "checks_needed": {"type": "array", "items": {"type": "string"}},
        "field_or_incarnation": {"type": "string"},
        "tv_hook": {"type": "string"},
        "radio_hook": {"type": "string"},
        "people_to_explore": {
          "type": "array",
          "items": {"$ref": "#/$defs/person"}
        },
        "verdict": {
          "enum": [
            "pret_a_lancer",
            "un_appel_necessaire",
            "a_developper",
            "information_seule",
            "a_ecarter"
          ]
        },
        "risk_flags": {"type": "array", "items": {"type": "string"}},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "sourceLead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "published_clue",
        "potential_reveal",
        "editorial_question",
        "first_verification",
        "certainty",
        "sources"
      ],
      "properties": {
        "title": {"type": "string"},
        "published_clue": {"type": "string"},
        "potential_reveal": {"type": "string"},
        "editorial_question": {"type": "string"},
        "first_verification": {"type": "string"},
        "certainty": {
          "enum": ["etabli", "rapporte", "declaration", "hypothese"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["source_class"],
            "properties": {
              "source_class": {
                "enum": [
                  "public_body",
                  "institution",
                  "civil_society",
                  "independent_public_body",
                  "regulator",
                  "parliament",
                  "social_partner",
                  "judiciary",
                  "health_insurer",
                  "statistics",
                  "consultative_body",
                  "public_company",
                  "scientific_institute",
                  "professional_body",
                  "consumer_association"
                ]
              }
            }
          },
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "longTermProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pitch",
        "structural_question",
        "fresh_starting_point",
        "why_in_line",
        "first_evidence",
        "research_tracks",
        "terrain_or_people",
        "blind_spots",
        "certainty",
        "sources"
      ],
      "properties": {
        "title": {"type": "string"},
        "pitch": {
          "type": "string",
          "pattern": "^On pourrait (raconter|enquêter|mesurer|tester)"
        },
        "structural_question": {"type": "string"},
        "fresh_starting_point": {"type": "string"},
        "why_in_line": {"type": "string"},
        "first_evidence": {"type": "array", "items": {"type": "string"}},
        "research_tracks": {"type": "array", "items": {"type": "string"}},
        "terrain_or_people": {"type": "array", "items": {"type": "string"}},
        "blind_spots": {"type": "array", "items": {"type": "string"}},
        "certainty": {
          "enum": ["etabli", "rapporte", "declaration", "hypothese"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "watchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "why_too_weak", "trigger", "sources"],
      "properties": {
        "signal": {"type": "string"},
        "why_too_weak": {"type": "string"},
        "trigger": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    }
  }
}
